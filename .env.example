# Copy to `.env` (project root) and adjust. `.env` is git-ignored — never commit real keys.

# ---- AI interpretation (optional) ----
# none   -> deterministic rule-based parser (default, no key needed)
# openai -> OpenAI Chat Completions API (or any OpenAI-compatible server via LLM_BASE_URL)
# gemini -> Google Gemini generateContent API
LLM_PROVIDER=none
LLM_API_KEY=
# Defaults: gpt-4o-mini (openai), gemini-2.5-flash (gemini)
LLM_MODEL=
# Optional: OpenAI-compatible endpoint, e.g. http://localhost:11434/v1 for a local Ollama server
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15

# ---- Backend ----
# Relative paths are resolved against the backend/ folder.
DATABASE_PATH=data/salesiq.db
CSV_PATH=data/sales_data.csv
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host/port are passed to uvicorn on the command line, e.g. --host 127.0.0.1 --port 8000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ---- Frontend (read by Vite; put in frontend/.env if you change it) ----
VITE_API_BASE_URL=http://localhost:8000
